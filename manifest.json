{
  "manifest_version": 3,
  "name": "Highlights",
  "version": "1.1",
  "description": "Highlight and save important text on webpages.",

  "browser_specific_settings": {
    "gecko": {
      "id": "highlights@richnoca",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "activeTab",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "content.js"]
    }
  ]
}
