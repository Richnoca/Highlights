{
  "manifest_version": 3,
  "name": "Highlights",
  "version": "1.5",
  "description": "Highlight and save important text on webpages, with colors, notes, tags, search and export.",

  "browser_specific_settings": {
    "gecko": {
      "id": "highlights@richnoca",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "menus"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlights",
    "default_icon": "icons/toolbar.svg"
  },

  "background": {
    "scripts": ["storage.js", "background.js"]
  },

  "commands": {
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Highlight the selected text"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "content.js"],
      "css": ["highlight.css"]
    }
  ]
}
